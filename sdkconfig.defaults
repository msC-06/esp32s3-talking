# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.5 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
CONFIG_FREERTOS_HZ=1000
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y

# 加入 LVGL/WiFi/摄像头/音频后，默认 1MB 的 app 分区不够用了，
# 改成自定义分区表（app 8MB + spiffs 3MB，和旧工程一致）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# TF 卡存档需要用长文件名（/sd/game_save/score_2048.txt），
# FATFS 默认关闭了长文件名支持（8.3 短名模式），必须打开，
# 否则 game_save(9 字符) 这类目录名在卡上"看不到"，fopen 直接失败
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# ---------------------------------------------------------------------------
# 【必须关掉】不要把 FatFS 的扇区缓冲放到 PSRAM 里！
#
# 现象（踩了很久的坑）：往 TF 卡写文件时目录项长度是对的（例如 157 字节），
# 但用电脑打开文件**是空的 / 全 0**，设备自己回读也读不到内容。
#
# 原因：SDMMC 驱动在 ESP32-S3 上不做 cache 回写。
#   components/esp_driver_sdmmc/src/sdmmc_transaction.c：
#       #if SOC_CACHE_INTERNAL_MEM_VIA_L1CACHE
#           esp_cache_msync(buf, len, ...C2M);   // 写卡前把 CPU cache 刷回内存
#       #endif
#   而 SOC_CACHE_INTERNAL_MEM_VIA_L1CACHE **只有 ESP32-P4 定义**（见 soc_caps.h），
#   S3 上这段直接被编译掉。于是：
#     - 缓冲在**内部 RAM**：S3 内部 RAM 不经 L1 cache，DMA 读到的一定是最新数据 ✅
#     - 缓冲在**PSRAM**：CPU 写入还躺在 cache 里，SDMMC 的 DMA 直接读 PSRAM，
#       读到的是旧内容（看起来就是整片 0）❌
#   CONFIG_FATFS_ALLOC_PREFER_EXTRAM 默认是 y（为了省内部 RAM），
#   在「S3 + TF 卡」这个组合下就会写出“有长度、没内容”的文件。
#
# 关掉之后 FatFS 的窗口/文件缓冲改用内部 RAM，多占 1~2KB 而已。
CONFIG_FATFS_PER_FILE_CACHE=y
# CONFIG_FATFS_ALLOC_PREFER_EXTRAM is not set

# ===========================================================================
# 对话掌机（按键录音 -> 百度 ASR -> DeepSeek LLM -> LCD 显示）需要的配置
# ===========================================================================

# 16MB Flash + 8MB Octal PSRAM，音频 PCM 缓冲（480KB）放 PSRAM
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 主频与系统节拍
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# HTTPS 客户端 + JSON 解析需要足够多的 socket 与根证书
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
# 发出方向的分片上限：发出去的请求被切成 2KB 的 TLS 记录就够了，省 2KB 内部堆。
# （IN 方向仍是 16384 —— 降它会扛不住服务器发来的 16KB 记录，等于拆掉安全网）
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
# 握手完还留着对端证书链没有任何用处（我们不看对端证书），关掉省约 4KB 内部堆/连接
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n

# 备用 DNS 服务器：DHCP 给的 DNS 偶尔不响应/被劫持，
# 日志现象是 getaddrinfo() returns 202（= lwip 的 EAI_FAIL，DNS 查询失败），
# 于是 aip.baidubce.com / api.deepseek.com 全都解析不出来。
# 打开 lwip 的 fallback DNS，主 DNS 失败时自动改用 223.5.5.5（阿里公共 DNS）。
CONFIG_LWIP_FALLBACK_DNS_SERVER_SUPPORT=y
CONFIG_LWIP_FALLBACK_DNS_SERVER_ADDRESS="223.5.5.5"

# SNTP 对时（app_time.c）：可以配 3 个 NTP 服务器（原本只有 1 个槽位）。
# 注意 UPDATE_DELAY 是 lwip 自己的重试周期（默认 1 小时），
# 本工程不依赖它：对时任务连上 WiFi 后会主动 esp_sntp_restart() 重试。
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# 初始化的 main 任务要建界面/开机动画，栈给大一点
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# LVGL 自己的内存池：聊天气泡里的长文本都从这里分配。
# 注意它是**内部 RAM 的静态数组**（不是 PSRAM），别盲目加大：
# 内部 DIRAM 被它占多了，运行时的任务栈/队列就会分配失败。
# 运行时空闲任务会打印这个池的占用率，够用就别动，不够再加。
CONFIG_LV_MEM_SIZE=65536
CONFIG_LV_MEM_SIZE_KILOBYTES=64

# 允许把 .bss 放到 PSRAM：大块文本缓冲（HTTP 响应、ASR/LLM 文本、工具结果）
# 用 EXT_RAM_BSS_ATTR 标一下就能放进 8MB PSRAM，给内部 DIRAM 留出运行时余量。
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# 允许任务栈分配在 PSRAM（本工程任务栈仍然走内部 RAM，这里只是放宽限制）
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# ---------------------------------------------------------------------------
# 开发阶段如果想“跳过 TLS 证书校验”（例如设备时间不对导致证书校验失败），
# 可以打开下面两行；生产环境请保持关闭，让 IDF 用内置根证书校验服务器。
#   CONFIG_ESP_TLS_INSECURE=y
#   CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
# 打开之后，再把 components/app/app_config.h 里的 APP_TLS_USE_CA_BUNDLE 改成 0。
# ---------------------------------------------------------------------------
